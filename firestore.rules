rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function chatOf(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data; }
    function member(cid) { return signed() && me() in chatOf(cid).members; }
    function callOf(id) { return get(/databases/$(database)/documents/calls/$(id)).data; }

    match /profiles/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid;
    }
    match /usernames/{name} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me();
      allow delete: if signed() && resource.data.uid == me();
    }
    match /pushsubs/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid;
    }
    match /presence/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid;
    }
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signed() && me() == uid;
    }
    match /chats/{cid} {
      allow read: if signed() && (resource == null || me() in resource.data.members || resource.data.type == 'group');
      allow create: if signed() && me() in request.resource.data.members;
      allow update: if signed() && (me() in resource.data.members || me() in request.resource.data.members);
      match /m/{bid} {
        allow read: if member(cid);
        allow write: if member(cid) && bid.matches(me() + '~[0-9]+') && request.resource.data.by == me();
      }
      match /st/{uid} {
        allow read: if member(cid);
        allow write: if member(cid) && me() == uid;
      }
    }
    match /status/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid;
    }
    match /sv/{owner}/v/{viewer} {
      allow read: if signed() && me() == owner;
      allow write: if signed() && me() == viewer;
    }
    match /channels/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.owner == me();
      allow update: if signed() && (resource.data.owner == me() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacts']));
      allow delete: if signed() && resource.data.owner == me();
    }
    match /comms/{id} {
      allow read: if signed();
      allow create: if signed() && me() in request.resource.data.members;
      allow update: if signed() && (me() in resource.data.members || me() in request.resource.data.members);
    }
    match /calls/{id} {
      allow read: if signed() && (resource == null || me() == resource.data.from || me() == resource.data.to);
      allow create: if signed() && request.resource.data.from == me();
      allow update: if signed() && (me() == resource.data.from || me() == resource.data.to);
      match /{sub}/{c} {
        allow read, write: if signed() && (me() == callOf(id).from || me() == callOf(id).to);
      }
    }
    match /media/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.owner == me();
      match /c/{n} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.owner == me();
      }
    }
  }
}
